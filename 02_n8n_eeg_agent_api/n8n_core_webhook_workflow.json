{
  "name": "EEG Schizophrenia API Gateway Workflow",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "eeg-agent",
        "responseMode": "responseNode",
        "options": {}
      },
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        220,
        300
      ],
      "id": "e4a7b98d-8a5b-4394-b152-4a0058b88cb1",
      "name": "Webhook Trigger",
      "webhookId": "eeg-agent-webhook"
    },
    {
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict"
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.body.action }}",
                    "rightValue": "predict",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              }
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict"
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.body.action }}",
                    "rightValue": "subject",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              }
            }
          ]
        },
        "options": {
          "fallbackOutput": "extra"
        }
      },
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3,
      "position": [
        460,
        300
      ],
      "id": "c8e1a742-0f3d-4c8e-a9d5-45d064cfbc19",
      "name": "Route Action"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://tri-fcc-favourite-pavilion.trycloudflare.com/predict",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ trial_data: $json.body.trial_data || [] }) }}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        720,
        180
      ],
      "id": "b1a2c3d4-e5f6-47a8-9b0c-1d2e3f4a5b6c",
      "name": "Call Predict API"
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=https://tri-fcc-favourite-pavilion.trycloudflare.com/subject/{{ $json.body.subject_id || 1 }}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        720,
        300
      ],
      "id": "c2b3a4d5-e6f7-48a9-0b1c-2d3e4f5a6b7c",
      "name": "Call Subject API"
    },
    {
      "parameters": {
        "method": "GET",
        "url": "https://tri-fcc-favourite-pavilion.trycloudflare.com/metrics",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        720,
        420
      ],
      "id": "d3c4b5a6-f7a8-49b0-1c2d-3e4f5a6b7c8d",
      "name": "Call Metrics API"
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify($json) }}",
        "options": {}
      },
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        980,
        300
      ],
      "id": "e5d6c7b8-a9f0-41c2-3d4e-5f6a7b8c9d0e",
      "name": "Respond to Webhook"
    }
  ],
  "connections": {
    "Webhook Trigger": {
      "main": [
        [
          {
            "node": "Route Action",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Route Action": {
      "main": [
        [
          {
            "node": "Call Predict API",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Call Subject API",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Call Metrics API",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Call Predict API": {
      "main": [
        [
          {
            "node": "Respond to Webhook",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Call Subject API": {
      "main": [
        [
          {
            "node": "Respond to Webhook",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Call Metrics API": {
      "main": [
        [
          {
            "node": "Respond to Webhook",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "pinData": {},
  "settings": {
    "executionOrder": "v1"
  }
}
